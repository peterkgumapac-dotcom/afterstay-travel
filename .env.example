# afterstay-travel — environment variables
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Every key is `EXPO_PUBLIC_*` because Expo only exposes that prefix to the
# JS bundle. Anything here ships to every installed app — do NOT put
# server-only secrets in this file. Server secrets belong behind a
# Supabase Edge Function.
#
# For EAS builds, mirror these into EAS Environment Variables for each
# environment (development / preview / production):
#   eas env:create --name <KEY> --value <VALUE> --visibility plaintext --environment <env>

# ─── Supabase (required) ─────────────────────────────────────────────────
# Anon key is safe to ship because RLS enforces row access. Without RLS,
# this is a full DB leak.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=YOUR_SUPABASE_ANON_KEY

# ─── Google Places (required) ────────────────────────────────────────────
# Same key referenced under two names for historical reasons. Set both.
# Restrict by bundle id (com.afterstay.travel) in Google Cloud Console.
EXPO_PUBLIC_GOOGLE_PLACES_KEY=YOUR_GOOGLE_PLACES_KEY
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_KEY

# ─── Google Sign-In (required for Google OAuth) ──────────────────────────
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# ─── Weather (optional) ──────────────────────────────────────────────────
# weatherapi.com — Home weather widget gracefully no-ops without it.
EXPO_PUBLIC_WEATHER_API_KEY=YOUR_WEATHER_KEY

# ─── Verified AfterStay account (required for verified badge) ────────────
# Server-issued userId of the platform's official AfterStay account.
# Empty string disables the verified-badge check (multi-tenant safe default).
# Without this set, the verified ✓ on profile and the gold rail / "AfterStay
# Pick" badge in Discover never render — even if the account exists.
EXPO_PUBLIC_OFFICIAL_AFTERSTAY_USER_ID=

# Internal QA/dev panel kill switch. Keep empty/false in production unless you
# intentionally want owner-only profile/lifecycle test tools in that OTA.
EXPO_PUBLIC_ENABLE_INTERNAL_QA=false

# ─── Legacy / deprecated (DO NOT SET in new installs) ────────────────────
# Notion was the original backend. Migration to Supabase is in progress;
# any remaining reads should be considered fallbacks. Setting these keys in
# a new install will not enable any feature path that isn't already on
# Supabase. They exist here only for awareness during cutover.
# EXPO_PUBLIC_NOTION_API_KEY=
# EXPO_PUBLIC_TRIP_PAGE_ID=
# EXPO_PUBLIC_NOTION_TRIP_DB=
# EXPO_PUBLIC_NOTION_PACKING_DB=
# EXPO_PUBLIC_NOTION_EXPENSES_DB=
# EXPO_PUBLIC_NOTION_FLIGHTS_DB=
# EXPO_PUBLIC_NOTION_PLACES_DB=
# EXPO_PUBLIC_NOTION_GROUP_DB=
# EXPO_PUBLIC_NOTION_CHECKLIST_DB=
# EXPO_PUBLIC_NOTION_MOMENTS_DB=
# EXPO_PUBLIC_NOTION_FILES_DB=

# Anthropic was bundled directly in the client; AI calls now go through the
# `ai-proxy` Supabase Edge Function. This key should not be set in new
# installs — anything still requiring it indicates an unmigrated call site.
# EXPO_PUBLIC_ANTHROPIC_API_KEY=
